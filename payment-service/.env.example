# Copy to .env and fill local values. Do not commit .env or real credentials.
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=http://localhost:5173/payment/result
PayOS__CancelUrl=http://localhost:5173/payment/cancel
PayOSWorker__ConfirmationPollIntervalSeconds=60

# Must match Core's JWT settings.
Jwt__SecretKey=
Jwt__Issuer=SmartParkingApi
Jwt__Audience=SmartParkingClient

# Must match Core's PaymentService:SharedSecret and contain at least 32 bytes.
PaymentService__SharedSecret=
Services__Core__BaseUrl=http://localhost:5295/

# Optional override for the Payment Service database connection.
ConnectionStrings__DefaultConnection=
